# Runtime Mode: 'live' for real Parallel Search API + Gemini calls, 'demo' for local deterministic fixtures
RUNTIME_MODE=demo

# Google Gemini Configuration
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.0-flash

# Server Configuration
PORT=8002
HOST=0.0.0.0
DEBUG=false
ENABLE_MOCK_FALLBACK=true

# Parallel Web Systems Configuration
PARALLEL_API_KEY=
PARALLEL_BASE_URL=https://api.parallel.ai/v1
